{
  "name": "fr05t1k/esia",
  "license": "MIT",
  "description": "OpenID ESIA authenticating",
  "keywords": [
    "esia",
    "openid",
    "egov"
  ],
  "autoload": {
    "psr-4": {
      "Esia\\": "src/Esia"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.9",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-client": "^1.0"
  },
  "require-dev": {
    "codeception/codeception": "^5.1",
    "codeception/module-asserts": "^3.0",
    "phpstan/phpstan": "^2.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "codeception/c3": true
    }
  }
}
